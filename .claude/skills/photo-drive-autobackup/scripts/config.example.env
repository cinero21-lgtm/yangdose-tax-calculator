# photo-autobackup 설정 — ~/.config/photo-autobackup/config.env 로 복사해서 고쳐 쓴다.

# rclone 리모트 이름 (rclone listremotes 로 확인. 콜론은 빼고 적는다)
RCLONE_REMOTE="gdrive"

# 구글드라이브 안에서 사진이 쌓일 최상위 폴더. 없으면 자동으로 만들어진다.
# 공백이 들어가도 되지만 반드시 따옴표로 감싸라.
# setup 에 이름을 주면 자동으로 채워진다:  setup "Z폴드 8 사진" "Z폴드 8 동영상"
DRIVE_FOLDER="PhoneCamera"

# --- 감시 모드(watch/once) 설정 ------------------------------------------------

# 새로 찍힌 사진을 감시할 폴더들. 공백으로 여러 개를 적을 수 있다.
WATCH_DIRS="$HOME/storage/dcim/Camera"

# 감시 모드에서 드라이브에 쌓는 방식
#   date   : Z폴드 8 사진/2026/2026-08/IMG_0001.jpg   (촬영 월별 정리)
#   mirror : Z폴드 8 사진/DCIM/Camera/IMG_0001.jpg    (폰 폴더 구조 그대로)
LAYOUT="date"

# --- 일괄 이관(migrate) 설정 ---------------------------------------------------

# 폰 전체를 훑을 최상위 경로. SD카드도 비우려면 공백으로 덧붙인다.
#   MIGRATE_ROOTS="$HOME/storage/shared /storage/1A2B-3C4D"
MIGRATE_ROOTS="$HOME/storage/shared"

# 일괄 이관 시 드라이브에 쌓는 방식. 폰 폴더 구조를 그대로 옮기는 게 기본이다.
MIGRATE_LAYOUT="mirror"

# --- 공통 -----------------------------------------------------------------------

# 사진으로 볼 확장자.
EXTENSIONS="jpg jpeg png heic heif dng webp"

# 동영상으로 볼 확장자. 아래 VIDEO_DRIVE_FOLDER 로 따로 들어간다.
# 동영상을 아예 다루고 싶지 않으면 VIDEO_EXTENSIONS="" 로 비운다.
VIDEO_EXTENSIONS="mp4 mov m4v mkv avi webm"

# 동영상이 쌓일 드라이브 폴더. 사진 폴더와 분리된다.
#   Z폴드 8 사진/DCIM/Camera/IMG_0001.jpg
#   Z폴드 8 동영상/DCIM/Camera/VID_0001.mp4
VIDEO_DRIVE_FOLDER="동영상"

# 촬영 직후 파일은 아직 기록 중일 수 있다. 이 초 수만큼 지난 파일만 건드린다.
MIN_AGE_SECONDS=20

# inotify가 없을 때의 폴링 주기(초).
POLL_SECONDS=60

# 사진·동영상을 폰에 그대로 두는 유예 기간(일). 찍은 지 이만큼 지나야 업로드
# 대상이 된다. 찍자마자 올려 치우면 정작 방금 찍은 걸 보려 할 때 없기 때문이다.
# 0 이면 유예 없이 즉시 올린다. 통화녹취는 이 설정과 무관하다(폰에 남기므로).
HOLD_DAYS=7

# 휴지통 보관 기간(일). 이 기간이 지나야 완전 삭제된다.
RETENTION_DAYS=30

# 같은 파일 업로드가 이 횟수만큼 실패하면 재시도를 멈춘다(모바일 데이터 낭비 방지).
# 원인을 고친 뒤 `photo-autobackup.sh reset-failures` 로 다시 열어 준다.
MAX_ATTEMPTS=5

# 1이면 Wi-Fi에 붙어 있을 때만 업로드한다. 사진 수천 장을 옮길 때는 켜 두는 게 좋다.
# 켜려면 termux-api 패키지와 Termux:API 앱이 있어야 한다.
REQUIRE_WIFI=0

# 1이면 업로드/삭제 없이 무엇을 할지 로그와 계획만 보여 준다. 처음 도입할 때 켠다.
DRY_RUN=0

# rclone에 항상 붙일 옵션. 예: 대역폭 제한, 동시 전송 수
# RCLONE_EXTRA_ARGS="--bwlimit 2M --transfers 2"
RCLONE_EXTRA_ARGS=""

# 휴지통/로그 위치를 바꾸고 싶을 때만 지정한다.
# TRASH_DIR="$HOME/.local/share/photo-autobackup/trash"
# LOG_FILE="$HOME/.local/share/photo-autobackup/autobackup.log"

# --- 통화녹취 -------------------------------------------------------------------
# 사진과 정책이 다르다: 올리되 폰에서 지우지 않는다(복사). 녹취는 작고, 폰에서도
# 바로 들을 수 있어야 하기 때문이다.

# 기본은 꺼져 있다. 통화 녹취에는 상대방 음성이 담기므로, 명시적으로 켜기 전에
# 클라우드로 올라가면 사고다. 먼저 `photo-autobackup.sh probe` 로 확인해라.
CALL_ENABLED=0

# 녹음 폴더. 비우면 자동 탐색한다(Recordings/Call, Recordings, Call, Sounds).
# probe 결과에 다른 경로가 보이면 여기에 직접 적는다.
# 여러 개는 줄을 바꿔 적는다 — 공백으로 나누면 공백이 든 경로가 깨진다.
#   CALL_DIRS="/storage/emulated/0/Call recordings
#   /storage/emulated/0/Recordings/Call"
CALL_DIRS=""

CALL_EXTENSIONS="m4a mp3 amr wav aac 3gp 3gpp"

# 전사(텍스트) 파일로 볼 확장자. 녹음과 같은 이름이면 같은 폴더로 함께 올라간다.
TRANSCRIPT_EXTENSIONS="txt md json srt vtt"

# 앱에서 전사를 손수 내보냈을 때 그 파일이 떨어지는 폴더.
# `photo-autobackup.sh transcripts` 가 여기를 뒤져, 파일명에 든 녹음 시각
# (YYMMDD_HHMMSS)으로 녹음을 찾아 같은 이름의 짝으로 복사해 준다.
# 그다음 `calls` 를 돌리면 녹음과 함께 올라간다.
# 비워 두면 Download, Download/KakaoTalk(카톡 '나와의 채팅'에서 저장한 파일이
# 떨어지는 곳), Documents 를 본다. 여러 개면 줄바꿈으로 나눠 적는다.
TRANSCRIPT_DROP_DIRS=""

CALL_DRIVE_IN="수신녹취"
CALL_DRIVE_OUT="발신통화녹취"
CALL_DRIVE_UNKNOWN="통화녹취_미분류"

# 파일명으로 수신/발신을 가르는 정규식. probe 의 파일명 샘플을 보고 맞춘다.
CALL_IN_PATTERN="수신|받은|incoming|_in_|^in[-_]"
CALL_OUT_PATTERN="발신|보낸|outgoing|_out_|^out[-_]"

# 파일명으로 못 가릴 때 통화기록과 시각을 대조하는 허용 오차(초).
CALL_LOG_WINDOW=90
